generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Every message Evolution reports (incoming + outgoing, DMs + groups).
model Message {
  id          String      @id @default(cuid())
  waMessageId String      @unique
  chatId      String
  chatName    String?
  senderPhone String?
  senderName  String?
  content     String
  rawMessage  Json
  messageType MessageType
  isGroup     Boolean     @default(false)
  isFromMe    Boolean     @default(false)
  isSelfChat  Boolean     @default(false)
  timestamp   DateTime
  createdAt   DateTime    @default(now())

  commandLogs CommandLog[]

  @@index([chatId, timestamp])
  @@index([isSelfChat, isFromMe, timestamp])
  @@index([chatName])
  @@index([timestamp])
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  CONTACT
  LOCATION
  OTHER
}

// Reminders scheduled by /reminder command; fired by the scheduler service.
model Reminder {
  id           String         @id @default(cuid())
  scheduledAt  DateTime
  message      String
  status       ReminderStatus @default(PENDING)
  createdByCmd String?
  createdAt    DateTime       @default(now())
  sentAt       DateTime?
  error        String?

  @@index([status, scheduledAt])
}

enum ReminderStatus {
  PENDING
  SENT
  MISSED
  CANCELLED
  FAILED
}

// Audit log of every command execution.
model CommandLog {
  id         String        @id @default(cuid())
  command    String
  args       String?
  rawInput   String
  messageId  String?
  message    Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  output     String?
  status     CommandStatus
  error      String?
  executedAt DateTime      @default(now())
  durationMs Int?

  @@index([executedAt])
  @@index([command, executedAt])
}

enum CommandStatus {
  SUCCESS
  FAILURE
  NOT_FOUND
}

// Key/value store for runtime config (e.g., detected self JID).
model Config {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// The single WhatsApp instance this app manages.
model Instance {
  id              String         @id @default(cuid())
  name            String         @unique
  phoneNumber     String?
  ownerJid        String?
  status          InstanceStatus @default(DISCONNECTED)
  lastConnectedAt DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum InstanceStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

// A person authorized to trigger commands by messaging the owner.
// When enabled, messages from this phone starting with "/" are processed
// as if the owner typed them — but the reply goes to the DELEGATE, not
// to self-chat.
model Delegate {
  id        String   @id @default(cuid())
  phone     String   @unique           // digits only, e.g. "14255245126"
  name      String                     // display name, e.g. "Jack Be Home Remodeling"
  enabled   Boolean  @default(true)    // owner can toggle on/off
  // Permissions: which command prefixes this delegate can use.
  // Empty array = read-only defaults (status*, audit, help, schedules, reminders).
  // ["*"] = all commands (same as owner). Use with caution.
  allowedCommands String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Generic scheduled task — runs an Action on a cron schedule or one-shot.
// Designed to be extensible: actionType is a plain string keyed into the
// ActionRegistry at runtime, and actionPayload is free-form JSON.
model ScheduledTask {
  id              String              @id @default(cuid())
  name            String                                       // human name for /schedules listing
  enabled         Boolean             @default(true)

  // One of these two must be set:
  cronExpression  String?                                      // e.g. "0 9 * * 1" (Mon 9am)
  fireAt          DateTime?                                    // one-shot absolute time

  // Action to run when the task fires.
  actionType      String                                       // "sendText" | "runCommand" | "webhook" | "sendVoice"
  actionPayload   Json                                         // arbitrary payload per action type

  lastFiredAt     DateTime?
  nextFireAt      DateTime?
  lastError       String?
  lastResult      String?                                      // truncated last action output
  runCount        Int                 @default(0)
  failureCount    Int                 @default(0)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([enabled, nextFireAt])
  @@index([enabled, fireAt])
}

// A WhatsApp reaction (emoji) on a message. We store the CURRENT reaction
// state per (targetWaMessageId, reactorPhone) — WhatsApp allows one reaction
// per person per message, and changing/removing it replaces the previous one.
// Soft-linked to Message.waMessageId via targetWaMessageId (no hard FK, in
// keeping with the project's flat-table philosophy).
model Reaction {
  id                String   @id @default(cuid())
  targetWaMessageId String                       // reactionMessage.key.id — the message reacted to
  reactionEventId   String?                      // the reaction event's own key.id (audit / dedupe)
  chatId            String                       // remoteJid stripped of @suffix
  chatName          String?
  reactorPhone      String?                      // resolved phone digits (NOT LID)
  reactorName       String?                      // resolved human name
  emoji             String                       // "✅" / "👍" / "❌"; "" when the reaction was removed
  removed           Boolean  @default(false)     // true when the person removed their reaction
  timestamp         DateTime                     // reaction event time
  rawEvent          Json                         // full Baileys/Evolution payload, for debugging / re-parsing
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([targetWaMessageId, reactorPhone])    // one current reaction per person per message
  @@index([targetWaMessageId])
  @@index([chatId, timestamp])
  @@index([emoji])
}

// A composable, event-driven automation:
//   scope(group) -> TRIGGER -> (optional delay) -> CONDITIONS -> ACTION
//
// The reaction-/event-triggered counterpart to the time-triggered
// ScheduledTask. triggerType/conditions are open strings + JSON validated
// against the trigger/condition registries; actionType/actionPayload are
// validated against the same ActionRegistry as ScheduledTask. New
// triggers/conditions/actions are drop-in primitives — no schema change.
model Automation {
  id            String   @id @default(cuid())
  name          String
  enabled       Boolean  @default(true)

  // Scope: which chat/group this watches. null = any chat.
  chatId        String?

  // TRIGGER — what event starts the automation.
  //   "lead_posted" | "message_posted" | "reaction_added" | "reaction_removed"
  triggerType   String
  // Trigger filters, type-specific: { source?, emoji?, reactorPhone?, fromPhone? }
  triggerConfig Json     @default("{}")

  // Optional wait (seconds) before evaluating conditions + running the action.
  // Backed by PendingAutomation so it survives restarts. 0 = immediate.
  delaySeconds  Int      @default(0)

  // Conditions evaluated at action time (after the delay), against live DB
  // state. Array of { type, ... } e.g. [{ "type": "no_reaction", "emoji": "👍" }].
  conditions    Json     @default("[]")

  // Action to run when the trigger fires and conditions pass (ActionRegistry).
  actionType    String                          // "sendText" | "runCommand" | "webhook" | "sendVoice"
  actionPayload Json

  lastFiredAt   DateTime?
  lastError     String?
  lastResult    String?                          // truncated last action output
  runCount      Int      @default(0)
  failureCount  Int      @default(0)             // consecutive failures; reset on success

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([enabled, triggerType])
  @@index([enabled, chatId])
}

// A deferred automation evaluation — created when an Automation with
// delaySeconds > 0 is triggered. The PendingAutomationRunner fires it at
// fireAt, evaluates the automation's conditions against current state, and
// runs the action. Persisted so a "wait 2 minutes then check" survives a
// container restart (recovered on boot, like ScheduledTask).
model PendingAutomation {
  id                String   @id @default(cuid())
  automationId      String
  targetWaMessageId String?                      // the message/lead that triggered it (for condition checks)
  chatId            String?
  triggerContext    Json     @default("{}")      // snapshot of trigger data (reactor, source, etc.)
  fireAt            DateTime
  status            String   @default("PENDING") // PENDING | DONE | CANCELLED
  createdAt         DateTime @default(now())

  @@index([status, fireAt])
  @@index([automationId])
}
